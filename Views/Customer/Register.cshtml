@{
    ViewData["Title"] = "จองคิว";
    Layout = "_Layout";
}

<!-- [ส่วนที่ 2.2] หน้าลงทะเบียนรับคิว (Register UI) ธีมกระจกใส -->
<style>
    .register-wrapper {
        min-height: calc(100vh - 160px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 12px;
    }
    .register-card { width: 100%; max-width: 440px; }
    .register-logo {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-bottom: 18px;
    }
    .register-card h3 { font-weight: 800; font-size: 1.9rem; margin-bottom: 4px; }
    .register-sub { color: #94a3b8; margin-bottom: 24px; }
    .field-label { font-weight: 600; margin-bottom: 6px; display: block; }
    .btn-pin { width: 100%; }
</style>

<div class="register-wrapper">
    <div class="register-card glass-card">
        <div class="register-logo">🍜</div>
        <h3 class="glass-title">ยินดีต้อนรับ</h3>
        <p class="register-sub">กรอกข้อมูลเพื่อรับหมายเลขคิว</p>

        <!-- [ข] แจ้งเวลานั่งสูงสุดต่อโต๊ะให้ลูกค้าทราบ -->
        <div id="timeLimitBox" class="alert alert-info py-2 small mb-3 rounded-4 d-none">
            ⏰ <span id="timeLimitText"></span>
        </div>

        <form id="queueForm">
            <div class="mb-3">
                <label class="field-label">ชื่อผู้จอง</label>
                <input type="text" class="form-control" id="customerName" required
                       placeholder="เช่น สมชาย" />
            </div>
            <div class="mb-3">
                <label class="field-label">จำนวนคน</label>
                <input type="number" class="form-control" id="customerCount"
                       min="1" max="50" value="1" required />
                <div class="form-text">กลุ่มโต๊ะ: A = 1-2 คน, B = 3-4 คน, C = 5+ คน</div>
            </div>

        <!-- 📍 GPS Status Box: แสดงตลอดเวลาที่รอ GPS -->
        <div id="geoBox" class="rounded-4 p-3 mb-3 d-none" style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span id="geoIcon" style="font-size:1.4rem;">📍</span>
                <strong id="geoTitle" style="font-size:.95rem;">กำลังค้นหาตำแหน่ง...</strong>
            </div>
            <div id="geoDesc" class="small" style="color:#cbd5e1;"></div>
            <button id="geoRetryBtn" class="btn-float btn-float-info mt-2 small d-none"
                    style="padding:6px 14px;font-size:.8rem;" onclick="requestGps()">
                🔄 ขอตำแหน่งใหม่
            </button>
        </div>

        <button type="submit" class="btn-float btn-float-primary btn-pin" id="submitBtn">
            รับคิว
        </button>
        </form>

        <div id="errorBox" class="alert alert-danger mt-3 d-none rounded-4"></div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPosition = null;
        let gpsWatchId = null;

        // --- ดึงค่าตั้งเวลาต่อโต๊ะมาแสดงให้ลูกค้าทราบ ---
        (async () => {
            try {
                const res = await fetch('@Url.Action("GetTableSettings", "Settings")');
                const settings = await res.json();
                if (!settings.length) return;
                const fmt = (m) => {
                    const h = Math.floor(m / 60), min = m % 60;
                    return (h ? h + ' ชม. ' : '') + (min ? min + ' นาที' : '');
                };
                const parts = settings.map(s => `กลุ่ม ${s.tableGroup} (${s.description}) ไม่เกิน ${fmt(s.maxMinutes)}`);
                document.getElementById('timeLimitText').innerHTML = 'จำกัดเวลานั่งต่อโต๊ะ<br>' + parts.join('<br>');
                document.getElementById('timeLimitBox').classList.remove('d-none');
            } catch {}
        })();

        // ค่าจาก server: มาจาก QR ไหม และเปิด GPS check ไหม
        const fromQr = @(ViewBag.RequireGps == true ? "true" : "false");
        const requireGps = fromQr && @(ViewBag.EnableGeoCheck == true ? "true" : "false");

        const submitBtn = document.getElementById('submitBtn');
        const geoBox = document.getElementById('geoBox');
        const geoIcon = document.getElementById('geoIcon');
        const geoTitle = document.getElementById('geoTitle');
        const geoDesc = document.getElementById('geoDesc');
        const geoRetry = document.getElementById('geoRetryBtn');

        // --- ปรับสถานะ UI ของ GPS box ---
        function setGeo(icon, title, desc, locked, showRetry) {
            geoBox.classList.remove('d-none');
            geoIcon.textContent = icon;
            geoTitle.textContent = title;
            geoDesc.textContent = desc;
            submitBtn.disabled = locked;
            submitBtn.textContent = locked ? '⏳ รอตรวจสอบตำแหน่ง...' : '✅ รับคิว';
            showRetry ? geoRetry.classList.remove('d-none') : geoRetry.classList.add('d-none');
        }

        // --- ขอ GPS และคอยจนกว่าจะได้พิกัด ---
        function requestGps() {
            if (!navigator.geolocation) {
                setGeo('❌', 'เบราว์เซอร์ไม่รองรับ GPS',
                    'กรุณาใช้ Chrome หรือ Safari เวอร์ชันใหม่', true, false);
                return;
            }

            setGeo('📍', 'กำลังค้นหาตำแหน่ง...',
                'กรุณากด "อนุญาต" เมื่อเบราว์เซอร์ขอเข้าถึงตำแหน่ง', true, false);

            // หยุด watch เก่าก่อน (ถ้ามี)
            if (gpsWatchId !== null) {
                navigator.geolocation.clearWatch(gpsWatchId);
            }

            // watchPosition จะวนหาพิกัดซ้ำจนกว่าจะได้ แล้วหยุดเอง
            gpsWatchId = navigator.geolocation.watchPosition(
                (pos) => {
                    // ✅ ได้พิกัดแล้ว
                    currentPosition = {
                        latitude: pos.coords.latitude,
                        longitude: pos.coords.longitude
                    };
                    const acc = pos.coords.accuracy ? `(ความแม่นยำ ~${Math.round(pos.coords.accuracy)} ม.)` : '';
                    setGeo('✅', 'ตรวจสอบตำแหน่งเรียบร้อย',
                        `พร้อมจองคิวแล้ว ${acc}`, false, false);

                    // หยุด watch ประหยัดแบตเมื่อได้พิกัดแล้ว
                    navigator.geolocation.clearWatch(gpsWatchId);
                    gpsWatchId = null;
                },
                (err) => {
                    currentPosition = null;
                    if (err.code === 1) { // PERMISSION_DENIED
                        setGeo('🔒', 'ไม่ได้รับอนุญาตเข้าถึง GPS',
                            'กรุณาไปที่การตั้งค่าเบราว์เซอร์ → อนุญาตการเข้าถึงตำแหน่ง แล้วกด "ขอตำแหน่งใหม่"',
                            true, true);
                    } else if (err.code === 2) { // POSITION_UNAVAILABLE
                        setGeo('⚠️', 'ไม่พบสัญญาณ GPS',
                            'กรุณาเปิด Location ที่การตั้งค่าเครื่อง และออกไปยืนในที่โล่ง แล้วกด "ขอตำแหน่งใหม่"',
                            true, true);
                    } else { // TIMEOUT
                        setGeo('⏰', 'ค้นหาตำแหน่งนานเกินไป',
                            'กำลังลองใหม่อัตโนมัติ กรุณาออกไปยืนในที่โล่งเพื่อรับสัญญาณดีขึ้น',
                            true, true);
                    }
                },
                {
                    enableHighAccuracy: true,
                    timeout: 20000,  // รอ GPS นาน 20 วินาทีต่อครั้ง
                    maximumAge: 0    // ไม่ใช้พิกัดเก่าจาก cache
                }
            );
        }

        // --- เริ่มทำงาน ---
        if (requireGps) {
            // บังคับขอ GPS ทันทีที่หน้าโหลด (เฉพาะมาจาก QR + เปิด EnableGeoCheck)
            submitBtn.disabled = true;
            submitBtn.textContent = '⏳ รอตรวจสอบตำแหน่ง...';
            requestGps();
        } else {
            // มาจากเมนู หรือปิด GPS check → เปิดปุ่มทันที
            submitBtn.disabled = false;
            submitBtn.textContent = 'รับคิว';
        }

        // --- ส่งฟอร์มรับคิว ---
        document.getElementById('queueForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('submitBtn');
            const errorBox = document.getElementById('errorBox');
            errorBox.classList.add('d-none');
            btn.disabled = true;
            btn.textContent = 'กำลังส่ง...';

            const payload = {
                customerName: document.getElementById('customerName').value,
                customerCount: parseInt(document.getElementById('customerCount').value, 10),
                latitude: currentPosition?.latitude ?? null,
                longitude: currentPosition?.longitude ?? null,
                fromQr: fromQr
            };

            try {
                const res = await fetch('@Url.Action("Register", "Customer")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.message || 'เกิดข้อผิดพลาด');
                window.location.href = '@Url.Action("Status", "Customer")/' + data.id;
            } catch (ex) {
                errorBox.textContent = ex.message;
                errorBox.classList.remove('d-none');
                btn.disabled = false;
                btn.textContent = 'รับคิว';
            }
        });
    </script>
}
