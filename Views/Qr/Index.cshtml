@{
    ViewData["Title"] = "QR Code หน้าร้าน";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card text-center mt-4">
            <h3 class="glass-title">🔳 QR Code สำหรับจองคิว</h3>
            <p class="text-muted">พิมพ์แล้วนำไปติดหน้าร้าน ให้ลูกค้าสแกนเพื่อรับคิว</p>

            <!-- ภาพ QR Code (PngByteQRCode) จาก QrController -->
            <div class="bg-white d-inline-block p-3 rounded-4 mt-2">
                <img src="@Url.Action("Image", "Qr")" alt="QR Code" class="img-fluid" style="max-width:280px;" />
            </div>

            <div class="mt-3">
                <div class="small text-muted">ลิงก์หน้าจองคิว:</div>
                <code class="text-info">@ViewBag.RegisterUrl</code>
            </div>

            <div class="mt-4 no-print">
                <button class="btn-float btn-float-primary" onclick="window.print()">🖨️ พิมพ์</button>
            </div>
        </div>
    </div>
</div>
